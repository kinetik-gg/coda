# Dokploy runtime variables for the canonical compose.app.yaml topology.
# Paste these into the Compose service's Environment editor and replace every
# placeholder. Keep the image digest matched to the verified release bundle.
CODA_IMAGE=ghcr.io/kinetik-gg/coda@sha256:61af3915e7933f87f091a10b6f60438f7db9e79084175e304d49255542129182
APP_ORIGIN=https://coda.example.com
# "auto" trusts the private subnets attached to this container, resolved at boot
# and logged. Replace it with the exact platform ingress source CIDRs to harden.
# Never mix "auto" with an explicit list, and never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=auto
DATABASE_URL=postgresql://user:replace-with-managed-database-password@db.example.com:5432/coda?schema=public&sslmode=require&sslaccept=strict
SESSION_COOKIE_NAME=coda_session
SESSION_TTL_DAYS=30
# SETUP_TOKEN is optional. Leave it unset and Coda generates a one-time setup
# token at first boot, printing it to the container logs until setup completes.
# Set an explicit value (>=32 characters) to choose the token yourself; this is
# required when running more than one replica.
# SETUP_TOKEN=replace-with-a-long-random-one-time-setup-token
# CONFIG_ENCRYPTION_KEY encrypts instance configuration, derives the backup
# signing key, and is required for the pre-upgrade safety backup. Generate it
# with `openssl rand -base64 32`, keep it stable, and back it up separately.
CONFIG_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://objects.example.com
S3_REGION=replace-with-provider-region
S3_BUCKET=replace-with-private-bucket-name
S3_ACCESS_KEY=replace-with-bucket-scoped-access-key
S3_SECRET_KEY=replace-with-bucket-scoped-secret-key
S3_FORCE_PATH_STYLE=false
LOG_LEVEL=info
# METRICS_TOKEN is optional and unset by default, which disables /metrics.
# Set an explicit value (>=16 characters) to enable it.
# METRICS_TOKEN=replace-with-a-long-random-metrics-scrape-token
