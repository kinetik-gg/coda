  // is rejected so a captured code cannot be replayed inside its validity window.
  lastUsedCounter BigInt? @map("last_used_counter")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_two_factor")
}

// Single-use recovery codes, argon2-hashed at rest and shown to the user only
// once at activation. `usedAt` marks a spent code without deleting it, so the
// count of remaining codes and the audit of consumption both survive.
model UserTwoFactorRecoveryCode {
  id String @id @default(uuid())
  userId String @map("user_id")
  codeHash String @map("code_hash")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_two_factor_recovery_codes")
}

// Short-lived, server-side handle issued after a correct password when the
// account has active TOTP. It carries no privileges of its own -- it is not a
// half-session -- and only a matching second factor exchanges it for a session.
// Only the SHA-256 hash of the handle is stored, mirroring session tokens.
model TwoFactorChallenge {
  id String @id @default(uuid())
  userId String @map("user_id")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

// Per-user panel layout for a single screenplay, mirroring the breakdown workspace's
// `ProjectMembershipWorkspaceLayout`: an optimistic `revision` guards concurrent writes and
// `schema_version` tracks the layout tree's shape for migrations. A layout is purely personal --
// keyed by the requesting `userId` and `screenplayId` -- with no published-default counterpart.
// Like the other appended operational tables this stays self-contained with plain
// `screenplayId`/`userId` columns and NO foreign key back onto Screenplay or User: an older backup
// dump does not know this table exists, so a `pg_restore --clean` of that dump onto a migrated
// database would be unable to drop a core constraint (e.g. screenplays_pkey) that a dependent FK
// relied on. Keeping it FK-free is what preserves the restore/upgrade path.
model ScreenplayPanelLayout {
  screenplayId String @map("screenplay_id")
  userId String @map("user_id")
  layout Json
  schemaVersion Int @map("schema_version")
  revision Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([screenplayId, userId])
  @@index([userId])
  @@map("screenplay_panel_layouts")
}

// Screenplay access control (ADR: docs/adr-screenplay-access-control.md). A screenplay-scoped
// mirror of the project role/membership/invitation graph so screenplays share with roles exactly
// as breakdown projects do. Ownership stays on Screenplay.ownerUserId; the owner always also holds
// the owner-role membership.
//
// Like the other appended operational tables (screenplay_panel_layouts, user_two_factor, ...) these
// carry plain `screenplayId`/`userId`/`inviterId` columns with NO relation/foreign key onto the core
// `Screenplay`/`User` tables: an older backup dump does not know these tables exist, so a
// `pg_restore --clean` of that dump would be unable to drop a core constraint a dependent FK relied
// on. Foreign keys strictly among these four new tables (via `roleId`) are safe and are kept.
model ScreenplayRole {
  id String @id @default(uuid())
  screenplayId String @map("screenplay_id")
  name String
  description String?
  isOwner Boolean @default(false) @map("is_owner")
  position String
  archivedAt DateTime? @map("archived_at")
  version Int @default(1)
  permissions ScreenplayRolePermission[]
  memberships ScreenplayMembership[]
  invitations ScreenplayInvitation[]

  @@unique([screenplayId, name])
  @@index([screenplayId, position])
  @@map("screenplay_roles")
}

model ScreenplayRolePermission {
  id String @id @default(uuid())
  roleId String @map("role_id")
  permission String
  role ScreenplayRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("screenplay_role_permissions")
}

model ScreenplayMembership {
  id String @id @default(uuid())
  screenplayId String @map("screenplay_id")
  userId String @map("user_id")
  roleId String @map("role_id")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  role ScreenplayRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([screenplayId, userId])
  @@index([userId])
  @@map("screenplay_memberships")
}

model ScreenplayInvitation {
  id String @id @default(uuid())
  screenplayId String @map("screenplay_id")
  roleId String @map("role_id")
  // Base types only (TEXT/VarChar), not the shared citext extension or String enum: those
  // core types live in an N-1 backup, so a dependent column would block pg_restore --clean from
  // dropping them during the backup round-trip. Email is already lowercased by the request schema.
  email String
  tokenHash String @unique @map("token_hash")
  status String @default("PENDING")
  inviterId String @map("inviter_id")
  acceptedById String? @map("accepted_by_id")
  expiresAt DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  role ScreenplayRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([screenplayId, status])
  @@map("screenplay_invitations")
}

// Spaces are the expand-only container above breakdown projects and screenplays; see
// docs/adr-spaces.md for the backup-compatibility and access decisions. The Default Space
// maps every pre-existing resource without creating a membership, so installing this schema does
// not grant anybody new access. `ownerUserId` is settings/rename authority only; it is deliberately
// not an access grant.
//
// Like the other appended operational tables (screenplay_memberships, screenplay_panel_layouts,
// ...) this graph carries plain `ownerUserId`/`userId`/`resourceId`/`inviterId` columns with NO
// relation/foreign key onto the core `User`/`Project`/`Screenplay` tables. An older backup dump does
// not know these tables exist, so a `pg_restore --clean` of that dump must remain free to drop core
// constraints and shared types. Foreign keys strictly among these six new tables (via `spaceId` and
// `roleId`) are safe and are kept.
model Space {
  id String @id @default(uuid())
  name String
  description String?
  ownerUserId String? @map("owner_user_id")
  isDefault Boolean @default(false) @map("is_default")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  resources SpaceResource[]
  roles SpaceRole[]
  memberships SpaceMembership[]
  invitations SpaceInvitation[]

  @@map("spaces")
}

model SpaceResource {
  id String @id @default(uuid())
  spaceId String @map("space_id")
  resourceType String @map("resource_type")
  resourceId String @map("resource_id")
  position String
  createdAt DateTime @default(now()) @map("created_at")
  space Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@unique([resourceType, resourceId])
  @@index([spaceId, resourceType, position])
  @@map("space_resources")
}

model SpaceRole {
  id String @id @default(uuid())
  spaceId String @map("space_id")
  name String
  description String?
  isOwner Boolean @default(false) @map("is_owner")
  position String
  archivedAt DateTime? @map("archived_at")
  version Int @default(1)
  resourceTier String @default("viewer") @map("resource_tier")
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  permissions SpaceRolePermission[]
  memberships SpaceMembership[]
  invitations SpaceInvitation[]

  @@unique([spaceId, name])
  @@index([spaceId, position])
  @@map("space_roles")
}

model SpaceRolePermission {
  id String @id @default(uuid())
  roleId String @map("role_id")
  permission String
  role SpaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("space_role_permissions")
}

model SpaceMembership {
  id String @id @default(uuid())
  spaceId String @map("space_id")
  userId String @map("user_id")
  roleId String @map("role_id")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  role SpaceRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_memberships")
}

model SpaceInvitation {
  id String @id @default(uuid())
  spaceId String @map("space_id")
  roleId String @map("role_id")
  // Base types only (TEXT/VarChar), not the shared citext extension or String enum: those
  // core types live in an N-1 backup, so a dependent column would block pg_restore --clean from
  // dropping them during the backup round-trip. Email is already lowercased by the request schema.
  email String
  tokenHash String @unique @map("token_hash")
  status String @default("PENDING")
  inviterId String @map("inviter_id")
  acceptedById String? @map("accepted_by_id")
  expiresAt DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  role SpaceRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([spaceId, status])
  @@map("space_invitations")
}

// Live collaboration (ADR: docs/adr-collaboration-engine-and-transport.md). Like the other appended
// operational tables (screenplay_panel_layouts, screenplay_memberships, user_two_factor, ...) these
// carry plain `screenplayId`/`userId` columns with NO relation/foreign key onto the core
// `Screenplay`/`User` tables, no shared enum type and no citext: an older backup dump does not know
// these tables exist, so a `pg_restore --clean` of that dump would be unable to drop a core
// constraint (e.g. screenplays_pkey) or a core type that a dependent column relied on.
model ScreenplayCollabUpdate {
  id String @id @default(uuid())
  screenplayId String @map("screenplay_id")
  seq Int
  authorUserId String @map("author_user_id")
  actorClientId String @map("actor_client_id")
  payload Bytes
  byteLength Int @map("byte_length")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([screenplayId, seq])
  @@index([screenplayId, createdAt])
  @@map("screenplay_collab_updates")
}

model ScreenplayCollabCheckpoint {
  screenplayId String @id @map("screenplay_id")
  throughSeq Int @map("through_seq")
  payload Bytes
  byteLength Int @map("byte_length")
  documentDigest String @map("document_digest")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("screenplay_collab_checkpoints")
}

model ScreenplayCommentThread {
  id String @id @default(uuid())
  screenplayId String @map("screenplay_id")
  authorUserId String @map("author_user_id")
  anchorStart Bytes @map("anchor_start")
  anchorEnd Bytes @map("anchor_end")
  quotedText String @map("quoted_text")
  status String @default("OPEN")
  resolvedAt DateTime? @map("resolved_at")
  resolvedById String? @map("resolved_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  comments ScreenplayComment[]

  @@index([screenplayId, status])
  @@map("screenplay_comment_threads")
}

model ScreenplayComment {
  id String @id @default(uuid())
  threadId String @map("thread_id")
  authorUserId String @map("author_user_id")
  body String
  createdAt DateTime @default(now()) @map("created_at")
  editedAt DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")
  thread ScreenplayCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("screenplay_comments")
}
